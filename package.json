{
  "name": "ai-file-renamer",
  "version": "1.0.0",
  "description": "小恐龙 AI 智能文件更名工具 - 小恐龙工作室",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "webpack serve --mode development",
    "dev": "concurrently -n web,electron -c blue,green \"npm run dev:web\" \"wait-on http://localhost:3266 && cross-env NODE_ENV=development electron .\"",
    "build": "webpack --mode production",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --win dir --config electron-builder.yml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "framer-motion": "^11.16.1",
    "lucide-react": "^0.294.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.5",
    "@babel/preset-typescript": "^7.23.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.5.3",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
